menuconfig LED_SUBSYSTEM
    bool "LED Subsystem"
    default y
    help
      Enable the LED subsystem.

if LED_SUBSYSTEM

choice
    prompt "LED blink sleep time"
    default LED_BLINK_SLEEP_TIME_1000MS
    help
      Select the LED driver to use.

config LED_BLINK_SLEEP_TIME_250MS
    bool "250ms (fast)"

config LED_BLINK_SLEEP_TIME_1000MS
    bool "1s (medium)"

config LED_BLINK_SLEEP_TIME_2000MS
    bool "2s (slow)"

endchoice

config LED_BLINK_SLEEP_TIME
    int
    default 250 if LED_BLINK_SLEEP_TIME_250MS
    default 1000 if LED_BLINK_SLEEP_TIME_1000MS
    default 2000 if LED_BLINK_SLEEP_TIME_2000MS

menuconfig LED_ADVANCED_SETTINGS
    bool "Advance LED settings"
    default n
    help
      Enable advanced LED settings.

if LED_ADVANCED_SETTINGS

  config LED_BRIGHTNESS
    int "LED brightness (0-100)"
    default 100
    range 0 100
    help
      Set the LED brightness level.

  config LED_FADE_DURATION
    int "LED fade duration (ms)"
    default 500
    help
      Set the LED fade duration.

  menu "Expert settings"

    config LED_DEBUGGING
        bool "Enable LED debugging"
        default n
        help
          Enable debugging for the LED subsystem.

    config CUSTOM_BLINK_PATTERN
        bool "Custom blink pattern"
        default n
        help
          Enable custom blink pattern for the LED.

  endmenu

endif # LED_ADVANCED_SETTINGS

endif # LED_SUBSYSTEM

source "Kconfig.zephyr"